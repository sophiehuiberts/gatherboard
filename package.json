{
  "name": "gatherboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/setup.mjs && tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "test:integration": "node tests/integration.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.156.0",
    "ws": "8.22.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
